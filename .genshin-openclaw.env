# 元神计划 OpenClaw 环境 — source ~/.genshin-openclaw.env
export MONA_DATA_ROOT="/Volumes/Destiny System Data"
export GENSHIN_DATA_ROOT="/Volumes/Destiny System Data"
export OPENCLAW_CONFIG_PATH="$HOME/.openclaw/openclaw.json"
export OPENCLAW_STATE_DIR="$HOME/.openclaw"
export OPENCLAW_HOME="$HOME/.openclaw"
export GENSHIN_PYTHON311="$HOME/.local/python311-standalone/python/bin/python3.11"
export NEURALMEMORY_BRAIN="${NEURALMEMORY_BRAIN:-genshin}"
export PATH="$HOME/.local/python311-standalone/python/bin:$HOME/Library/Python/3.11/bin:$HOME/.local/node-v22/bin:$HOME/.local/bin:$PATH"
# 飞书官方 CLI / MCP（npm -g @larksuite/cli @larksuiteoapi/lark-mcp）
export GENSHIN_API_KEYS_FILE="/Volumes/Destiny System Data/05-Config/genshin-api-keys.env"

KEYS_FILE="/Volumes/Destiny System Data/05-Config/genshin-api-keys.env"
if [ -f "$KEYS_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$KEYS_FILE"
  set +a
fi
# MiniMax 已退役 (2026-06)；勿再 export MINIMAX_*
# VOLCENGINE_AGENT_PLAN_API_KEY：仅生图/生视频脚本（见 workspace/.kimi/media-routing.json）
export GENSHIN_PROJECT="/Volumes/Destiny System Data/01-Projects/genshin-openclaw"
export GENSHIN_WORKSPACE="/Volumes/Destiny System Data/01-Projects/genshin-openclaw/workspace"

# Kimi Code CLI
export PATH="$HOME/.kimi-code/bin:$PATH"
export KIMI_CODE_HOME="/Users/hufujun/.kimi-code"
export KIMI_CONFIG_FILE="/Users/hufujun/.kimi-code/config.toml"

# Kimi WebBridge + Kimi Code
export PATH="$HOME/.kimi-webbridge/bin:$HOME/.kimi-code/bin:$PATH"

# Homebrew (mole / mo)
export PATH="/opt/homebrew/bin:$PATH"

# OfficeCLI (Word/Excel/PPT)
export PATH="$HOME/.officecli/bin:$PATH"

# migrated from TRAE
export VOLCENGINE_AGENT_PLAN_API_KEY="ark-6b18954b-6913-4a1a-874c-36a6fa94519f-d84be"

# migrated from TRAE
export KIMI_API_KEY="sk-kimi-3rp9wB2vvglHONX4fxYNboQErpnvDGdhYiRlVTOt1B5JJSm46Sg9uRvp8FZmoUV0"

# ComfyUI (install-comfyui-volcengine.sh)
export COMFYUI_HOST=127.0.0.1:8188
export COMFYUI_DIR="$HOME/ComfyUI"

# Kimi App 飞书入口（非 OpenClaw channels.feishu）
export GENSHIN_INGRESS_CHANNEL="kimi-claw"
